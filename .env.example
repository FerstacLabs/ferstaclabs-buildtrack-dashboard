# Production: replace blanks locally; never commit .env. Use existing secrets on migration.
# REQUIRED registry/tag and EXISTING storage. Do not invent a new volume name.
COMPOSE_PROJECT_NAME=ferstaclabs-buildtrack-dashboard
BUILDTRACK_IMAGE_REGISTRY=ghcr.io/ferstaclabs/ferstaclabs-buildtrack-dashboard
BUILDTRACK_IMAGE_TAG=main
BUILDTRACK_POSTGRES_VOLUME=
BUILDTRACK_DATA_PATH=
DAHUA_SDK_RUNTIME_PATH=
# REQUIRED. DB password must match the existing database role; env does NOT rotate it.
BUILDTRACK_DB_PASSWORD=
# REQUIRED >=32 characters. Keep existing encryption key to decrypt camera credentials.
JWT_SECRET=
BUILDTRACK_SECRET_KEY=
# Optional backend-only credentials. Copy existing values securely, do not rotate on deploy.
DAHUA_ACTIVE_REGISTER_PASSWORD_OVERRIDE=
DAHUA_CGI_PASSWORD=
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=false
OPENAI_TTS_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
CORS_ALLOWED_ORIGINS=https://ferstaclabs-buildtrack-dashboard.vercel.app,https://app.buildtrack.ferstaclabs.com,https://field.buildtrack.ferstaclabs.com,https://supply.buildtrack.ferstaclabs.com,https://buildtrack.ferstaclabs.com
# Vercel only; never add backend secrets to VITE_*.
VITE_API_BASE_URL=https://api.buildtrack.ferstaclabs.com
# Seeding is opt-in; existing users are preserved. Production reset flags remain false.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_RESET_PASSWORD=false
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_PASSWORD=
SEED_BAKINITY_DEMO=false
SEED_BAKINITY_DEMO_RESET=false
SEED_BAKINITY_DEMO_PASSWORD=
SEED_BAKINITY_DEMO_PRORAB_PASSWORD=
SEED_BAKINITY_DEMO_SUPPLY_PASSWORD=
SEED_SKYSNAP_DEMO=false
SEED_SKYSNAP_DEMO_RESET=false
SEED_SKYSNAP_DEMO_PASSWORD=
